{
  "name": "image-analysis-studio",
  "version": "1.0.0",
  "description": "AI-powered image analysis tool with Electron",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/test_local_ai_client.js",
    "test:fuzz:vector": "node tests/test_fuzz_handwired_vector.js",
    "test:fuzz:graph": ".\\venv\\Scripts\\python tests/test_fuzz_graphmemory.py",
    "test:bdd": ".\\venv\\Scripts\\python -m unittest tests/test_openspec_bdd.py",
    "test:all": "node scripts/test_local_ai_client.js && node tests/test_fuzz_handwired_vector.js && .\\venv\\Scripts\\python -m unittest discover tests",
    "llama:vision": "start_llama_server.bat",
    "llama:vision:4b": "start_llama_vision_4b.bat",
    "llama:embed": "start_llama_embeddings.bat",
    "laya:serve": "start_laya_server.bat",
    "ovis:serve": "start_ovis_server.bat",
    "ovis:pipeline": "run_ovis_pipeline.bat",
    "ovis:classify": "run_ovis_pipeline.bat --mode=classify",
    "ovis:embed": "run_ovis_pipeline.bat --mode=embed",
    "evoc:ovis": ".\\venv\\Scripts\\python scripts/evoc_pipeline.py --embeddings public/ovis-embeddings.json --db images.db",
    "ls:sync": ".\\venv\\Scripts\\python scripts/sync_ls.py",
    "ls:serve": "scripts\\serve_ls.bat",
    "build": "electron-builder",
    "postinstall": "node scripts/sync_libs.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "@duckdb/duckdb-wasm": "^1.30.0",
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^12.9.0",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "electron": "^33.2.1",
    "exif-parser": "^0.1.12",
    "exifr": "^7.1.3",
    "express": "^4.21.1",
    "fuse.js": "^7.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron-builder": "^26.8.1",
    "fast-check": "^4.10.2"
  },
  "build": {
    "appId": "com.lmaistudio.app",
    "productName": "LM AI Studio",
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test/**",
      "!venv/**",
      "!dist/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
